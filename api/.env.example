NODE_ENV=production
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=papeleria_db
DB_USER=papeleria_user
DB_PASS=cambia_esto_por_la_contraseña_real_de_tu_db

# JWT
JWT_SECRET=cambia_este_secreto_en_produccion_minimo_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# Contraseñas de las cuentas de prueba creadas por seed.js
# (nunca commitear valores reales; define esto solo en tu api/.env.local)
SEED_ADMIN_PASSWORD=cambia_esto
SEED_ASESOR_PASSWORD=cambia_esto
SEED_REPARTIDOR_PASSWORD=cambia_esto
SEED_SUPERVISOR_PASSWORD=cambia_esto
SEED_CREADOR_PASSWORD=cambia_esto
SEED_ADMIN_EMPRESA_PASSWORD=cambia_esto

# Almacenamiento de adjuntos (local en desarrollo)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/var/www/papeleria-cartagena/uploads
STORAGE_BASE_URL=http://34.68.179.13/uploads

# GCS (activar en producción)
# STORAGE_TYPE=gcs
# GCS_BUCKET=papeleria-cartagena-uploads
# GCS_KEY_FILE=/etc/papeleria/gcs-key.json

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://34.68.179.13
